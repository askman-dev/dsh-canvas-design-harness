{
  "name": "dsh-canvas-design-harness",
  "version": "0.1.0",
  "description": "canvas-design-harness as a dual-spec package: a Codex/Claude skill under .agents/skills/ AND a DeepSeek Harness plugin bundle that registers it via ctx.skills.register.",
  "license": "MIT",
  "type": "module",
  "main": "plugin.js",
  "exports": {
    ".": "./plugin.js",
    "./host/tools-entry.js": "./host/tools-entry.js",
    "./client": "./client/bundle.js",
    "./package.json": "./package.json"
  },
  "files": [
    "plugin.js",
    "host",
    "client",
    "scripts",
    "cordis.patch.yml",
    ".agents/skills",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/askman-dev/dsh-canvas-design-harness.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "skill",
    "plugin",
    "canvas",
    "design"
  ],
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "test": "node test/smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
